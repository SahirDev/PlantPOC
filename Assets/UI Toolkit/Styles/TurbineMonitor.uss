:root {
}



.grid-box {
    flex-grow: 0;
    background-color: rgba(27, 56, 154, 0.686);
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    width: 30%;
    height: 44%;
    align-items: flex-start;
    flex-direction: column;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.grid-box-double {
    flex-wrap: wrap;
    width: 63%;
}

.bar {
    flex-grow: 0;
    width: 100%;
    height: 100px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}



.grid-box-title {
    font-size: 40px;
    -unity-text-align: middle-center;
    color: rgb(224, 224, 224);
    height: 70px;
    background-color: rgb(1, 4, 23);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
}

.grid-box-icon {
    flex-grow: 0;
    align-items: flex-end;
    width: 200px;
    height: 200px;
    background-image: url("project://database/Assets/UI%20Toolkit/Icons/temperature.png?fileID=2800000&guid=3b488f6f64a0f4942804a4957df8689c&type=3#temperature");
}

.unity-text-element {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Inter_28pt-SemiBold.ttf?fileID=12800000&guid=4d13222730ac3a54ab319fbe6062ddcb&type=3#Inter_28pt-SemiBold");
}
