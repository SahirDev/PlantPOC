<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/BoilerDashboard.uss?fileID=7433441132597879392&amp;guid=9ae8b6c1d4471d941b932f1acad30c9c&amp;type=3#BoilerDashboard"/>
    <ui:VisualElement name="dashboard-root" class="root">
        <ui:VisualElement name="dashboard-panel" class="panel" style="display: flex; transform-origin: center center 1px; translate: 675px 132px; height: 900px; width: 700px; scale: 0.7 0.7 0.7;">
            <ui:Label text="FURNACE ROOM / UNIT 01" class="eyebrow"/>
            <ui:Label text="BOILER CONTROL" class="main-title"/>
            <ui:Label name="status-label" text="STOPPED" class="status-label"/>
            <ui:VisualElement class="header-divider"/>
            <ui:VisualElement class="cards-grid">
                <ui:VisualElement class="metric-card">
                    <ui:Label text="TEMPERATURE" class="metric-label"/>
                    <ui:Label name="temperature-value" text="25.0 °C" class="metric-value temperature-value"/>
                    <ui:Slider name="temperature-slider" low-value="0" high-value="100" value="25" style="display: none;"/>
                </ui:VisualElement>
                <ui:VisualElement class="metric-card">
                    <ui:Label text="WATER LEVEL" class="metric-label"/>
                    <ui:Label name="water-value" text="70.0 %" class="metric-value water-value"/>
                    <ui:Slider name="water-slider" low-value="0" high-value="100" value="70" style="display: none;"/>
                </ui:VisualElement>
                <ui:VisualElement class="metric-card">
                    <ui:Label text="STEAM PRESSURE" class="metric-label"/>
                    <ui:Label name="pressure-value" text="0.00 bar" class="metric-value pressure-value"/>
                    <ui:Slider name="pressure-slider" low-value="0" high-value="15" value="0" style="display: none;"/>
                </ui:VisualElement>
                <ui:VisualElement class="metric-card">
                    <ui:Label text="BURNER OUTPUT" class="metric-label"/>
                    <ui:Label name="burner-output-value" text="45 %" class="metric-value burner-value"/>
                    <ui:Slider name="burner-output-slider" low-value="0" high-value="100" value="45" style="display: none;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="wide-card">
                <ui:Label text="STEAM VALVE" class="metric-label"/>
                <ui:Label name="steam-valve-value" text="0 %" class="wide-value"/>
                <ui:Slider name="steam-valve-slider" low-value="0" high-value="100" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement class="wide-card">
                <ui:Label text="BURNER POWER" class="metric-label"/>
                <ui:Slider name="burner-power-slider" low-value="0" high-value="100"/>
            </ui:VisualElement>
            <ui:VisualElement class="button-row" style="display: flex;">
                <ui:Button name="start-button" text="START" class="control-button start-button" style="display: none;"/>
                <ui:Button name="stop-button" text="STOP" class="control-button stop-button" style="display: none;"/>
                <ui:Button name="restart-button" text="RESET" class="control-button reset-button" style="display: flex;"/>
            </ui:VisualElement>
            <ui:Label name="footer-status" text="SYSTEM READY" class="footer-status"/>
            <ui:Button text="Close" name="close" style="background-color: rgb(197, 62, 62);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
