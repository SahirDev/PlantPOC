  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjectInfo
  displayName: Condensor Unit 01
  description: "A system that removes heat from exhaust steam after it leaves the
    turbine, allowing the steam to condense back into water. The recovered water
